#!/bin/bash

GREEN='\033[1;32m'
ORANGE='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m' # No Colour

cd "$(cd $(dirname $0)/..; pwd)"
if [[ -z "$VIRTUAL_ENV" ]]; then
   source .venv/bin/activate
fi

echo -e "${GREEN}>>> Updating English translations...${NC}"
python3 scripts/update_en_translation.py || exit

# Look for values still in English, whether or not the translation files have
# uncommitted changes (they may have been committed before translating).
python3 scripts/translate_missing.py --check >/dev/null
check_status=$?
if [[ $check_status -eq 3 ]]; then
    echo -e "${GREEN}>>> Updating native translations...${NC}"
    if [[ -e scripts/.deepl ]]; then
        source scripts/.deepl
        export DEEPL_AUTH_KEY
    else
        echo -e "${RED}>>> ERROR: DeepL API key not available!${NC}"
    fi
    python3 scripts/translate_missing.py || exit

    echo -e "${GREEN}>>> Checking translations...${NC}"
    python3 scripts/verify_translations.py || exit
elif [[ $check_status -ne 0 ]]; then
    echo -e "${RED}>>> ERROR: Could not check for untranslated values!${NC}"
    exit $check_status
else
    echo -e "${GREEN}>>> No untranslated values found.${NC}"
fi
