#!/bin/bash

set -eo pipefail

[ -z "$quiet" ] && python3 --version
if which -s uv; then
  UV=uv
  [ -z "$quiet" ] && uv --version
else
  ROOT_USER_ACTION="--root-user-action=ignore"
  [ -z "$quiet" ] && pip --version
fi

cd "$(cd $(dirname $0)/..; pwd)"
if [[ -z "$VIRTUAL_ENV" ]]; then
  if [[ ! -d .venv ]]; then
    if [[ -z "$UV" ]]; then
      python3 -m venv .venv
    else
      uv venv .venv
    fi
  fi 
  source .venv/bin/activate
fi

install_only=0
install_build_deps=1
no_upgrade=0
quiet=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --install-only)
      install_only=1
      ;;
    --no-upgrade)
      no_upgrade=1
      ;;
    --skip-build-deps)
      install_build_deps=0
      ;;
    -q|--quiet)
      quiet=">/dev/null 2>&1"
      ;;
    -h|--help)
      cat <<'USAGE'
Usage: scripts/dependencies [--install-only] [--skip-build-deps]

Options:
  --install-only      Install dependency specs only; do not update pyproject.toml
                      and do not run removal/autoremove logic.
  --no-upgrade        Do not upgrade existing packages
  --skip-build-deps   Do not install build/test helper dependencies.
  -h, --help          Show this help text.
USAGE
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
  shift
done

check_pkg () {
  local spec="$1"
  local add_after="$2"
  local pkg="${spec%%[=(]*}"

  [ -z "$pkg" ] && { echo ">>> ERROR: Failed to extract package name from spec: $spec" >&2; exit 1; }

  if [[ "$install_only" -eq 1 ]]; then
    $UV pip install "$spec" $ROOT_USER_ACTION --no-cache-dir $quiet || exit 1
    return
  fi

  [ -z "$quiet" ] && echo ">>> Checking $pkg..."

  if ! $UV pip show $pkg --quiet; then
    $UV pip install "$spec" $ROOT_USER_ACTION $quiet || exit 1
  elif [[ $no_upgrade -eq 0 ]]; then
    $UV pip install "$spec" --upgrade $ROOT_USER_ACTION $quiet || exit 1
  fi

  if [[ -n "$add_after" ]]; then
    local version="$($UV pip show "$pkg" | grep -Eo 'Version: [^ ]+' | cut -d' ' -f2)"
    if grep -Eq "${pkg}==" pyproject.toml; then
      sed -e "s/${pkg}==[^\"]*/${pkg}==${version}/" -i pyproject.toml
    else
      sed -e "/${add_after}/a\    \"${pkg}==${version}\"," -i pyproject.toml
    fi
  fi
}

[ -z "$quiet" ] && python3 --version
if which -s uv; then
  UV=uv
  [ -z "$quiet" ] && uv --version
else
  ROOT_USER_ACTION="--root-user-action=ignore"
  [ -z "$quiet" ] && pip --version
fi

eval $UV pip install --upgrade $UV pip $quiet

if [[ "$install_build_deps" -eq 1 ]]; then
  for spec in \
      "build(>=1.3.0,<2.0.0)" \
      "twine(>=6.2.0,<8.0.0)" \
      "pytest" \
      "pytest-asyncio" \
      "pytest-cov" \
      "pytest-xdist" \
      "jsonschema" \
      "deepl" \
  ; do
    check_pkg "$spec"
  done
fi

after="dependencies"
for spec in \
    "aiohttp(>=3.9.0,<4.0.0)" \
    "paho-mqtt(>=2.1.0,<3.0.0)" \
    "psutil(>=7.0.0,<8.0.0)" \
    "pydantic-settings(>=2.13.1,<3.0.0)" \
    "pymodbus(>=3.9.2,<4.0.0)" \
    "requests(>=2.32.4,<3.0.0)" \
    "ruamel.yaml(>=0.19.1,<1.0.0)" \
; do
  check_pkg "$spec" $after
  pkgs="$pkgs $spec"
  after="${spec%%[=(]*}"
done

if [[ "$install_only" -eq 0 ]]; then
  for spec in $(sed -ne '/dependencies =/,/\]/p' pyproject.toml | tail -n +2 | head -n -1 | tr -d '",' | xargs); do
    pkg="${spec%%[=(]*}"
    echo "$pkgs" | grep -Eq "$pkg[=(]" || { sed -e "/$pkg[=(]/d" -i pyproject.toml; echo ">>> Removing $pkg"; $UV pip uninstall $pkg; }
  done
fi
